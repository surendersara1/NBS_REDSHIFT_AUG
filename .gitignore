__pycache__/
*.pyc
.venv/
cdk.out/
*.swp
.DS_Store

# Resolved SQL carries this learner's account id and role ARNs. Generated by
# scripts/render_sql.sh; never committed.
sql/_resolved/

# CDK caches account-specific lookups (availability zones) here. Normally you
# WOULD commit this, but every learner deploys into their own account/region,
# so a cached lookup from someone else's account is worse than no cache.
infra/cdk.context.json

# ── Archived: TeachMe-Lakehouse ──────────────────────────────
# These files are kept on disk as a personal backup but are NOT
# tracked by git.  The last committed version is preserved in
# git history (commit before this .gitignore change).
TeachMe-Lakehouse/
